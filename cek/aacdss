<?php
// Simpan sebagai get_domains.php
$username = 'stppmeda';
$command = "/usr/local/cpanel/bin/uapi --user={$username} DomainInfo list_domains";
exec($command, $output, $return_var);

if ($return_var === 0) {
    $data = json_decode(implode("\n", $output), true);
    print_r($data);
} else {
    echo "Error: " . implode("\n", $output);
}
?>
