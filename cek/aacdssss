#!/bin/bash
# Simpan sebagai get_user_info.sh

USER="stppmeda"

echo "Informasi untuk user: $USER"
echo "================================"

# Ambil homedir dari /etc/passwd
HOMEDIR=$(grep "^$USER:" /etc/passwd | cut -d: -f6)
echo "Homedir: $HOMEDIR"

# Cek domain dari file konfigurasi
if [ -f /etc/userdatadomains ]; then
    grep "$USER" /etc/userdatadomains | while read line; do
        echo "Domain: $line"
    done
fi
